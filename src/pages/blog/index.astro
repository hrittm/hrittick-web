---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../data/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<Base title="Blog" description="Writing by Hrittick.">
  <section id="top">
    <h1 class="page-title">Blog</h1>
    {posts.length === 0 ? (
      <p class="about">First post coming soon.</p>
    ) : (
      <div>
        {posts.map((p) => (
          <a class="post" href={`/blog/${p.id}/`}>
            <h3>{p.data.title}</h3>
            <span class="yr">{formatDate(p.data.pubDate)}</span>
            <p>{p.data.description}</p>
          </a>
        ))}
      </div>
    )}
    <div class="next"><a href="/contact/">Next: Contact</a></div>
  </section>
</Base>
